# Grammble environment variables.
# Copy to .env and fill in real values. .env is gitignored; this template is not.
# Every var below is read by the app (grepped from process.env); missing ones
# either crash on boot (throw) or silently degrade a feature.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# CRITICAL: must be exactly "production" on the live server. Stripe keys, the
# webhook secret, and price IDs all switch on this value -- if it is anything
# other than "production", the app silently uses the Stripe TEST keys and real
# payments will not work.
NODE_ENV=production

# Public base URL of the deployment. Used for Stripe redirect URLs and email links.
APP_URL=https://grammble.com

# ---------------------------------------------------------------------------
# Database (Prisma + PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/grammble

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Session-signing secret. Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical auth origin; trusted automatically. Usually same as APP_URL.
BETTER_AUTH_URL=https://grammble.com
# Optional extra trusted origins (comma-separated) for LAN/dev hosts.
AUTH_TRUSTED_ORIGINS=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Redis (sessions + rate limiting)
# ---------------------------------------------------------------------------
# Preferred: a full connection URL. If unset, the app falls back to the
# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD trio below (defaults localhost:6379).
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Email (AWS SES)
# ---------------------------------------------------------------------------
# SES_FROM_EMAIL is required -- the email module throws on boot if it is unset.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@grammble.com

# ---------------------------------------------------------------------------
# Stripe -- LIVE (used when NODE_ENV=production)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# ---------------------------------------------------------------------------
# Stripe -- TEST (used when NODE_ENV is not "production")
# ---------------------------------------------------------------------------
STRIPE_SECRET_TEST_KEY=
STRIPE_WEBHOOK_TEST_SECRET=
STRIPE_MONTHLY_TEST_PRICE_ID=
STRIPE_ANNUAL_TEST_PRICE_ID=
